# Rust
target/

# IDEs
.vscode/
.idea/

# OS
.DS_Store
# AppleDouble sidecars (`._name`) that macOS leaves on the self-hosted runner's
# clean:false tree; otherwise they read as untracked and `cargo publish` aborts.
._*
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.swp

.env*
.secrets*
tmp/
.mcp.json
# Local agent state stays ignored; only the repo-native add-adapter skill is
# committed (git never descends into ignored dirs, hence the unignore cascade).
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/add-adapter/
*/**/.agents/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/add-adapter
skills-lock.json
/packages/pond/benches/corpus/

# AGENTS.md is the canonical, tracked instructions file; CLAUDE.md is a local
# symlink to it for Claude Code (which reads CLAUDE.md). Keep the symlink local.
/CLAUDE.md

# Release pipeline artifacts created in the working tree. The self-hosted runner
# uses clean:false, so these persist between runs and would otherwise dirty the
# tree and make `cargo publish` refuse to release.
/dist/
/minisign*

# Benchmark fixtures/results and any query set derived from the operator's
# corpus capture full conversation content (including API keys, wallet
# addresses, and private project paths embedded in indexed messages). The
# paraphrased query set is also derivative - even after paraphrasing the
# topics and project names leak. Regenerate locally via `bench.py`. Never
# commit these.
/packages/pond/benches/docs/search-benchmarks/fixtures/
/packages/pond/benches/docs/search-benchmarks/results/
/packages/pond/benches/docs/search-benchmarks/queries-paraphrased*.tsv
/packages/pond/benches/docs/search-benchmarks/queries-real-use*.tsv
/packages/pond/benches/docs/search-benchmarks/queries-false-negatives*.tsv
/packages/pond/benches/docs/search-benchmarks/arms*.json
/packages/pond/benches/docs/search-benchmarks/__pycache__/

# Corpus snapshot enumerates the operator's projects by name; aggregate
# stats appear inline in the benchmark report. Regenerate via `pond status`.
/docs/researches/embeddings/snapshot.txt

# moon local cache (rebuilt on demand; never commit)
/.moon/cache/
# generated from vcs.hooks in workspace.yml on every moon run
/.moon/hooks/

# wrangler local state/cache (created by `wrangler deploy`)
/.wrangler/

# nix build output symlink
/result

# playwright-cli local session state (directory, plus the stray marker file it drops)
/.playwright-cli

# SQLite reader artifacts next to the fixture databases. The pi fixture DB is a
# real WAL database - that is the shape the adapter meets in production, so it
# stays WAL - and any read-only open materializes a `-shm` (plus an empty
# `-wal`). Transient process state, never fixture content.
/packages/pond/tests/fixtures/**/*-shm
/packages/pond/tests/fixtures/**/*-wal
