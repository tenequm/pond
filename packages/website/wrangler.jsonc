{
  "name": "pond-docs",
  "compatibility_date": "2026-06-03",
  "main": "./worker.ts",
  "assets": {
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    // The tracker proxy and the reads the Worker reports. Everything else (media, /assets, legacy
    // redirects) stays asset-first and still reaches the Worker's uncached 404 on a miss.
    "run_worker_first": ["/mesh/*", "/", "/docs/*", "/llms.txt", "/llms-full.txt", "/robots.txt", "/sitemap.xml"]
  },
  "routes": [
    {
      "pattern": "pond.locker",
      "custom_domain": true
    }
  ],
  "vars": {
    "RYBBIT_HOST": "https://analytics.glim.sh",
    "RYBBIT_SITE_ID": "878f707ff553"
  }
}
