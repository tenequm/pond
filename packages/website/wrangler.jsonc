{
  "name": "pond-docs",
  "compatibility_date": "2026-06-03",
  "main": "./worker.ts",
  "assets": {
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    // Leave media on asset-first routing so a missing /assets file still reaches the uncached 404.
    "run_worker_first": [
      "/mesh/*", "/", "/index", "/*.html", "/*/", "/404", "/docs", "/docs/*",
      "/why", "/compare", "/spec", "/changelog", "/get-started/*", "/guides/*", "/reference/*",
      "/llms.txt", "/llms-full.txt", "/robots.txt", "/sitemap.xml"
    ]
  },
  "routes": [
    {
      "pattern": "pond.locker",
      "custom_domain": true
    }
  ],
  "vars": {
    "RYBBIT_HOST": "https://analytics.glim.sh",
    "RYBBIT_SITE_ID": "878f707ff553"
  }
}
