{
  "name": "pond-docs",
  "compatibility_date": "2026-06-03",
  "main": "./worker.ts",
  "assets": {
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/mesh/*"
    ]
  },
  "routes": [
    {
      "pattern": "pond.locker",
      "custom_domain": true
    }
  ],
  "vars": {
    "RYBBIT_HOST": "https://analytics.glim.sh"
  }
}
