                {
                  "type": "frame",
                  "id": "IGGJv",
                  "name": "spacer",
                  "width": "fill_container",
                  "height": 16,
                  "layout": "none"
                },
                {
                  "type": "frame",
                  "id": "cUuo8",
                  "width": "fill_container",
                  "layout": "vertical",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "g9sSZ",
                      "name": "Running the Linux binary under WSL works",
                      "context": "p",
                      "fill": "#e9e9e9",
                      "textGrowth": "fixed-width-height",
                      "width": 358,
                      "height": 136,
                      "content": "Running the Linux binary under WSL works when both the agent session files and the pond store live on the ext4 side. Do not point either across /mnt/c: throughput collapses and Windows-side writes are missed.",
                      "lineHeight": 1.63,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Q8PEM",
