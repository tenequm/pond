                {
                  "type": "frame",
                  "id": "O95Q6u",
                  "name": "spacer",
                  "width": "fill_container",
                  "height": 24,
                  "layout": "none"
                },
                {
                  "type": "frame",
                  "id": "f8jXQ7",
                  "width": "fill_container",
                  "layout": "vertical",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "J6BZeu",
                      "name": "Every adapter is bidirectional, so any s",
                      "context": "p",
                      "fill": "#e9e9e9",
                      "textGrowth": "fixed-width-height",
                      "width": 742.56,
                      "height": 78,
                      "content": "Every adapter is bidirectional, so any stored session can be restored into any of these clients - native restore is lossless, cross-client restore is best-effort in the target's own feature set. A new adapter is one file plus a registry line; more clients (Cursor, aider, Gemini CLI) are on the roadmap.",
                      "lineHeight": 1.63,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "v8Swm",
                  "name": "spacer",
                  "width": "fill_container",
                  "height": 40,
                  "layout": "none"
                },
                {
                  "type": "frame",
                  "id": "WQyIF",
                  "width": "fill_container",
                  "layout": "vertical",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "HFxbi",
                      "name": "h2",
                      "context": "h2",
                      "width": 742.55,
                      "height": 57,
                      "stroke": "#2b2b2b",
                      "strokeWidth": {
                        "top": 1
                      },
                      "strokeAlignment": "inner",
                      "layout": "vertical",
                      "padding": [
                        29.5,
                        0,
                        0,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "KyKd3",
                          "name": "Local by default, nothing phones home",
                          "fill": "#ffffff",
                          "content": "Local by default, nothing phones home",
                          "lineHeight": 1,
                          "fontFamily": "Geist",
                          "fontSize": 24,
                          "fontWeight": "500",
                          "letterSpacing": -0.6
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "B7chW5",
                  "name": "spacer",
                  "width": "fill_container",
                  "height": 24,
                  "layout": "none"
                },
                {
                  "type": "frame",
                  "id": "MBsSi",
                  "width": "fill_container",
                  "layout": "vertical",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "mceoO",
                      "name": "Everything runs on your machine: ingest,",
                      "context": "p",
                      "fill": "#e9e9e9",
                      "textGrowth": "fixed-width-height",
                      "width": 742.56,
                      "height": 130,
                      "content": "Everything runs on your machine: ingest, search, SQL, and, if you turn on semantic search, the embedding model (Metal on macOS, CPU elsewhere - no embedding API, no keys). pond sends no telemetry. Its only network traffic is the storage you explicitly configure, plus the one-time embedding-model download if you enabled semantic search, cached locally. Your sessions live in a local directory unless you point pond at your own bucket - and then they go there and nowhere else.",
                      "lineHeight": 1.63,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "OQsxO",
                  "name": "spacer",
                  "width": "fill_container",
                  "height": 40,
                  "layout": "none"
                },
                {
                  "type": "frame",
                  "id": "sr3jG",
                  "width": "fill_container",
                  "layout": "vertical",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "vWsw6",
                      "name": "h2",
                      "context": "h2",
                      "width": 742.55,
                      "height": 57,
                      "stroke": "#2b2b2b",
                      "strokeWidth": {
                        "top": 1
                      },
                      "strokeAlignment": "inner",
                      "layout": "vertical",
                      "padding": [
                        29.5,
                        0,
                        0,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "Vlh3X",
                          "name": "The problem",
                          "fill": "#ffffff",
                          "content": "The problem",
                          "lineHeight": 1,
                          "fontFamily": "Geist",
                          "fontSize": 24,
                          "fontWeight": "500",
                          "letterSpacing": -0.6
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "GMjwu",
                  "name": "spacer",
                  "width": "fill_container",
                  "height": 24,
                  "layout": "none"
                },
                {
                  "type": "frame",
                  "id": "JGmn8",
                  "width": "fill_container",
                  "layout": "vertical",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "d3fs8",
                      "name": "Agent history is your most valuable bypr",
                      "context": "p",
                      "fill": "#e9e9e9",
                      "textGrowth": "fixed-width-height",
                      "width": 742.56,
                      "height": 78,
                      "content": "Agent history is your most valuable byproduct - decisions, dead ends, the command that worked - yet it's siloed per client, in per-tool formats, and disposable: rotate a machine or hit a retention window and it's gone. No cross-tool search, no continuing a Claude Code thread in Codex.",
                      "lineHeight": 1.63,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "wOsfK",
                  "name": "spacer",
                  "width": "fill_container",
                  "height": 16,
                  "layout": "none"
                },
                {
                  "type": "frame",
                  "id": "m0nhX",
                  "width": "fill_container",
                  "layout": "vertical",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "tOYb7",
                      "name": "pond's premise: a session should outlive",
                      "context": "p",
                      "fill": "#e9e9e9",
                      "content": "pond's premise: a session should outlive the tool that made it. Three rules follow:",
                      "lineHeight": 1.63,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "nw2CL",
                  "name": "spacer",
                  "width": "fill_container",
                  "height": 16,
                  "layout": "none"
                },
                {
                  "type": "frame",
                  "id": "X0kfwD",
                  "width": "fill_container",
                  "layout": "vertical",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "ZxI1X",
                      "name": "ul",
                      "context": "ul",
                      "width": 742.55,
                      "layout": "vertical",
                      "gap": 8,
                      "padding": [
                        0,
                        0,
                        0,
                        24
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "l5X9XS",
                          "name": "Interchange, not storage. The canonical ",
                          "context": "li",
                          "fill": "#e9e9e9",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 78,
                          "content": "Interchange, not storage. The canonical schema is a format-neutral interlingua. Adapters parse client formats in and serialize them back out, so any session restores into any client. That schema is the product.",
                          "lineHeight": 1.63,
                          "fontFamily": "Geist",
                          "fontSize": 16,
                          "fontWeight": "normal",
                          "letterSpacing": 0.08
                        },
                        {
                          "type": "text",
                          "id": "ScCbH",
                          "name": "Lossless = value-complete. Every value r",
                          "context": "li",
                          "fill": "#e9e9e9",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 52,
                          "content": "Lossless = value-complete. Every value round-trips as an equal value. Restore is rederivation, not byte replay - incidental encoding isn't data; nothing that is data is dropped.",
                          "lineHeight": 1.63,
                          "fontFamily": "Geist",
                          "fontSize": 16,
                          "fontWeight": "normal",
                          "letterSpacing": 0.08
                        },
                        {
                          "type": "text",
                          "id": "V9SQHr",
                          "name": "Preservation over convenience. When pres",
                          "context": "li",
                          "fill": "#e9e9e9",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 52,
                          "content": "Preservation over convenience. When preserving a session fights readability or size, preservation wins.",
                          "lineHeight": 1.63,
                          "fontFamily": "Geist",
                          "fontSize": 16,
                          "fontWeight": "normal",
                          "letterSpacing": 0.08
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "swCWg",
                  "name": "spacer",
                  "width": "fill_container",
                  "height": 40,
                  "layout": "none"
                },
                {
                  "type": "frame",
                  "id": "QcDF4",
                  "width": "fill_container",
                  "layout": "vertical",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "jv4fk",
                      "name": "h2",
                      "context": "h2",
                      "width": 742.55,
                      "height": 57,
                      "stroke": "#2b2b2b",
                      "strokeWidth": {
                        "top": 1
                      },
                      "strokeAlignment": "inner",
                      "layout": "vertical",
                      "padding": [
                        29.5,
                        0,
                        0,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "zYzK6",
                          "name": "Two audiences, one source",
                          "fill": "#ffffff",
                          "content": "Two audiences, one source",
                          "lineHeight": 1,
                          "fontFamily": "Geist",
                          "fontSize": 24,
                          "fontWeight": "500",
                          "letterSpacing": -0.6
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "kPXBT",
                  "name": "spacer",
                  "width": "fill_container",
                  "height": 24,
                  "layout": "none"
                },
                {
                  "type": "frame",
                  "id": "ltXtF",
                  "width": "fill_container",
                  "layout": "vertical",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "mg9zo",
                      "name": "ul",
                      "context": "ul",
                      "width": 742.55,
                      "layout": "vertical",
                      "gap": 8,
                      "padding": [
                        0,
                        0,
                        0,
                        24
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "JDNoj",
                          "name": "Humans: one binary, one searchable archi",
                          "context": "li",
                          "fill": "#e9e9e9",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 52,
                          "content": "Humans: one binary, one searchable archive across every client; ask any agent about your past work. Backend switches and rollbacks are one command; the local copy stays as a backup.",
                          "lineHeight": 1.63,
                          "fontFamily": "Geist",
                          "fontSize": 16,
                          "fontWeight": "normal",
                          "letterSpacing": 0.08
                        },
                        {
                          "type": "text",
                          "id": "znzz1",
                          "name": "Agents: pond is an MCP server - pond_sea",
                          "context": "li",
                          "fill": "#e9e9e9",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 90,
                          "content": "Agents: pond is an MCP server - pond_search / pond_get_session / pond_get_message / pond_sql over the user's full cross-client history, no per-client integration. Every command is exit-code-gated for CI.",
                          "lineHeight": 1.63,
                          "fontFamily": "Geist",
                          "fontSize": 16,
                          "fontWeight": "normal",
                          "letterSpacing": 0.08
                        }
                      ]
                    }
                  ]
