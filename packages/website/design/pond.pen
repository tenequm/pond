                {
                  "type": "frame",
                  "id": "r8LNt",
                  "width": "fill_container",
                  "layout": "vertical",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "BCrIf",
                      "name": "Buckets are git clones, so scoop bucket ",
                      "context": "p",
                      "fill": "#e9e9e9",
                      "textGrowth": "fixed-width-height",
                      "width": 358,
                      "height": 232,
                      "content": "Buckets are git clones, so scoop bucket add needs git on PATH - if it fails with \"Git is required for buckets\", run scoop install git and retry. No Scoop yet? Install it first, from a normal (non-admin) PowerShell - its installer refuses an elevated shell, and it lives entirely in your user profile. It needs an execution policy of RemoteSigned or looser:",
                      "lineHeight": 1.63,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "FsImC",
                  "name": "spacer",
                  "width": "fill_container",
