                                      "type": "text",
                                      "id": "h817eJ",
                                      "name": "s3+https://nbg1.your-objectstorage.com/m",
                                      "context": "span",
                                      "fill": "#96d0ff",
                                      "content": " s3+https://nbg1.your-objectstorage.com/my-pond",
                                      "lineHeight": 1.75,
                                      "fontFamily": "SFMono-Regular",
                                      "fontSize": 14,
                                      "fontWeight": "normal",
                                      "letterSpacing": 0.08
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "iwYxP",
                              "name": "Parses, resolves creds, runs a condition",
                              "context": "p",
                              "fill": "#e9e9e9",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 58,
                              "content": "Parses, resolves creds, runs a conditional put, reads back, deletes. Exit 0 = usable. See Exit codes.",
                              "lineHeight": 1.63,
                              "fontFamily": "Geist",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "OnfGM",
                              "name": "The check also runs the create-only copy",
                              "context": "p",
                              "fill": "#e9e9e9",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 110,
                              "content": "The check also runs the create-only copy Lance creates every table with. Where a backend rejects Lance's default (a multipart copy, which Hetzner refuses with 411), pond creates tables with a plain conditional copy instead, and the check says so in a note. A backend that rejects both fails the check with exit 5.",
                              "lineHeight": 1.63,
                              "fontFamily": "Geist",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "xPgiP",
                              "name": "A passing check can still print a check:",
                              "context": "p",
                              "fill": "#e9e9e9",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 84,
                              "content": "A passing check can still print a check: note. On backends that honor If-None-Match on puts but not on copies (Hetzner), it says the namespace markers Lance writes when it creates a table are not atomic there. Commits are unaffected; create a new store from one host at a time.",
                              "lineHeight": 1.63,
                              "fontFamily": "Geist",
                              "fontSize": 16,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
