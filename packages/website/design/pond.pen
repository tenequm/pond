                      "strokeAlignment": "inner",
                      "layout": "vertical",
                      "padding": [
                        29.5,
                        0,
                        0,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "HX5Y4",
                          "name": "How it works",
                          "fill": "#ffffff",
                          "content": "How it works",
                          "lineHeight": 1,
                          "fontFamily": "Geist",
                          "fontSize": 24,
                          "fontWeight": "500",
