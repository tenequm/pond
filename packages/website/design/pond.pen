                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "sEWkx",
                          "name": "Isn't this another memory tool?",
                          "fill": "#ffffff",
                          "content": "Isn't this another memory tool?",
                          "lineHeight": 1,
                          "fontFamily": "Geist",
                          "fontSize": 24,
                          "fontWeight": "500",
                          "letterSpacing": -0.6
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "u6Vto",
                  "name": "spacer",
                  "width": "fill_container",
                  "height": 24,
                  "layout": "none"
                },
                {
                  "type": "frame",
                  "id": "YMhYv",
                  "width": "fill_container",
                  "layout": "vertical",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "DPGPh",
                      "name": "No - it's the layer underneath one. Memo",
                      "context": "p",
                      "fill": "#e9e9e9",
                      "textGrowth": "fixed-width-height",
                      "width": 742.56,
                      "height": 130,
                      "content": "No - it's the layer underneath one. Memory tools store what they decided you'd need - facts, summaries, filed chunks; the sessions themselves are gone. Pond keeps the sessions: every message, tool call, and result, value-complete, cross-client, in storage you own, never pruned - searchable over MCP and restorable into any client. Memory is a derived view you can always rebuild from an archive; an archive can never be rebuilt from memories.",
                      "lineHeight": 1.63,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "b8zw3z",
                  "name": "spacer",
                  "width": "fill_container",
                  "height": 40,
                  "layout": "none"
                },
                {
                  "type": "frame",
                  "id": "eAOER",
                  "width": "fill_container",
