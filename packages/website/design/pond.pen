                },
                {
                  "type": "frame",
                  "id": "Ymwk6",
                  "width": "fill_container",
                  "layout": "vertical",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "o7gE3",
                      "name": "brew upgrade pond / nix profile upgrade ",
                      "context": "p",
                      "fill": "#e9e9e9",
                      "textGrowth": "fixed-width-height",
                      "width": 358,
                      "height": 290,
                      "content": "brew upgrade pond / nix profile upgrade pond / scoop update pond / cargo binstall pond-db (re-run) / a fresh zip - and pond --version to check what you're on. Keep every machine that writes to a shared store on the same version: a store-schema release migrates the store in place, after which older binaries stop syncing until they upgrade (see Several machines, one bucket).",
                      "lineHeight": 1.63,
                      "fontFamily": "Geist",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
